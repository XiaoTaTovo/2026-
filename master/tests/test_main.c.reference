    TestLineFollowEvents();
    TestTurnLineReacquire();
    TestH2026WideAreaCannotReacquireTurn();
    TestH2026CaptureGrayGuidanceCompatibility();
    TestH2026CaptureTimeoutUsesExistingSearchBudget();
    TestH2026CaptureCenterWinsBoundaryFrame();
    TestH2026LineFollowSeekConverges();
    TestH2026ArmedAnyProbeStartsCapture();
    TestH2026DiagonalCaptureTimeoutSearchesThenFails();
    TestH2026FalseCornerRejected();
    TestH2026ObliqueStraightHandoff();
    TestH2026ArcAxleApproachPrecedesAngleExit();
    TestH2026RequiredLineSearchStopsSafely();
    TestArcHeadingHandoff();
    TestH2026ArcAndHeadingLimits();
    TestH2026ArcLineTailHandoff();
    TestOfficialTrackControl();
    TestOfficialFinishMarker();
    TestOfficialTrackLossStops();
    TestAdaptiveLineDistanceExit();
    TestOfficialResultTimingWrap();
    TestFaultTimingRetention();
    TestFirmwareChain();
    puts("2024 legacy and 2026 H master firmware tests passed");
    return 0;
}
