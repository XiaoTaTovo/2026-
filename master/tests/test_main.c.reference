static void TestSetOfficialGray(CarInputSnapshot *input,
                                uint32_t now_ms,
                                bool wide)
{
    for (uint8_t i = 0U; i < 8U; i++) {
        input->gray.normalized[i] = wide ? 1000U : 0U;
    }
    if (!wide) {
        input->gray.normalized[3] = 1000U;
        input->gray.normalized[4] = 1000U;
    }
    input->gray.timestamp_ms = now_ms;
    input->gray.valid = true;
}

static void TestOfficialResultTimingWrap(void)
{
    CarConfig config = CarConfig_MakeDefault();
    CarApp app;
    CarInputSnapshot input = {0};
    CarOutputSnapshot output;
    uint32_t start_ms = UINT32_MAX - 100U;
    uint32_t now_ms;

    /* One encoder count is approximately 1 mm, which keeps this end-to-end
     * route timing test readable while exercising uint32_t time wrap. */
    config.wheel_diameter_mm = 318.309886f;
    config.encoder_counts_per_wheel_rev = 1000.0f;
    config.gray_shape_filter_enable = true;
    config.gray_track_enter_frames = 1U;
    config.line_follow_kp = 0.025f;
    config.arc_effective_track_width_mm = 100.0f;
    config.finish_sensor_to_test_point_mm = 150.0f;
    config.finish_approach_speed_mm_s = 100.0f;
    config.required_line_search_mm = 80.0f;
    config.track_wheel_accel_limit_mm_s2 = 0.0f;

    input.encoder.valid = true;
    input.encoder.timestamp_ms = start_ms;
    input.imu.valid = true;
    input.imu.timestamp_ms = start_ms;
    TestSetOfficialGray(&input, start_ms, false);
    assert(CarApp_Init(&app, &config) == CAR_OK);
    assert(CarApp_Arm(&app, H2026_MODE_B2, start_ms, &input) == CAR_OK);

#define TEST_OFFICIAL_STEP(ms_offset, count, wide_line)                     \
    do {                                                                    \
        now_ms = start_ms + (ms_offset);                                    \
        input.encoder.left_count = (int16_t)(count);                        \
        input.encoder.right_count = (int16_t)(count);                       \
        input.encoder.timestamp_ms = now_ms;                                \
        input.imu.timestamp_ms = now_ms;                                    \
        TestSetOfficialGray(&input, now_ms, (wide_line));                   \
        assert(CarApp_Update(&app, now_ms, &input, &output) == CAR_OK);      \
    } while (0)

    TEST_OFFICIAL_STEP(20U, 0, false);       /* START -> first straight */
    TEST_OFFICIAL_STEP(40U, 1498, false);    /* first straight -> arc */
    TEST_OFFICIAL_STEP(60U, 3066, false);    /* first arc -> straight */
    TEST_OFFICIAL_STEP(80U, 4564, false);    /* second straight -> arc */
    TEST_OFFICIAL_STEP(100U, 5564, false);   /* establish track lock */
    TEST_OFFICIAL_STEP(110U, 5970, false);   /* continuous narrow track */
    TEST_OFFICIAL_STEP(120U, 5982, true);    /* marker about 150 mm early */
    TEST_OFFICIAL_STEP(140U, 5988, true);    /* confirmed marker */
    TEST_OFFICIAL_STEP(150U, 6050, false);   /* offset keeps final arc */
    assert(output.motor.enable);
    assert(output.motor.left_mm_s > output.motor.right_mm_s);
    TEST_OFFICIAL_STEP(160U, 6135, true);    /* test point reaches A */

#undef TEST_OFFICIAL_STEP

    assert(output.result_valid);
    assert(output.result_time_ms == 160U);
    assert(output.run_time_ms == 160U);
    assert(app.executor.index == 5U);
    assert(!output.motor.enable);
}

static void TestFaultTimingRetention(void)
{
    CarConfig config = CarConfig_MakeDefault();
    CarApp app;
    CarInputSnapshot input = {0};
    CarOutputSnapshot output;

    config.gray_shape_filter_enable = true;
    config.gray_track_enter_frames = 1U;
    input.encoder.valid = true;
    input.encoder.timestamp_ms = 1000U;
    input.imu.valid = true;
    input.imu.timestamp_ms = 1000U;
    TestSetOfficialGray(&input, 1000U, false);
    assert(CarApp_Init(&app, &config) == CAR_OK);
    assert(CarApp_Arm(&app, H2026_MODE_B2, 1000U, &input) == CAR_OK);

    input.encoder.timestamp_ms = 1020U;
    input.imu.timestamp_ms = 1020U;
    TestSetOfficialGray(&input, 1020U, false);
    assert(CarApp_Update(&app, 1020U, &input, &output) == CAR_OK);

    input.emergency_stop = true;
    input.encoder.timestamp_ms = 1040U;
    input.imu.timestamp_ms = 1040U;
    TestSetOfficialGray(&input, 1040U, false);
    assert(CarApp_Update(&app, 1040U, &input, &output) ==
           CAR_ERROR_STATE);
    assert(output.run_time_ms == 40U);

    input.emergency_stop = false;
    input.encoder.timestamp_ms = 1060U;
    input.imu.timestamp_ms = 1060U;
    TestSetOfficialGray(&input, 1060U, false);
    assert(CarApp_Update(&app, 1060U, &input, &output) ==
           CAR_ERROR_STATE);
    assert(output.run_time_ms == 40U);
}

