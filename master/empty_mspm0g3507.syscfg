WWDT1.$name               = "WWDT0";
WWDT1.clockDivider        = "4";
WWDT1.wwdtMode            = "WATCHDOG";
WWDT1.periodCount         = "15";
WWDT1.activeWindow        = "0";
WWDT1.window0ClosedPeriod = "0";
