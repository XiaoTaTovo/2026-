/**
 * 2024 H car minimum peripheral configuration.
 * MSPM0 SDK 2.09, MSPM0G3507 LQFP-64.
 */
//@cliArgs --device "MSPM0G350X" --package "LQFP-64(PM)" --part "Default" --product "mspm0_sdk@2.09.00.02"
//@v2CliArgs --device "MSPM0G3507" --package "LQFP-64(PM)" --product "mspm0_sdk@2.09.00.02"

const ADC12         = scripting.addModule("/ti/driverlib/ADC12", {}, false);
const ADC_GRAY      = ADC12.addInstance();
const GPIO          = scripting.addModule("/ti/driverlib/GPIO", {}, false);
const GPIO_GRAY     = GPIO.addInstance();
const GPIO_IMU      = GPIO.addInstance();
const GPIO_KEYS     = GPIO.addInstance();
const GPIO_BUZZER   = GPIO.addInstance();
const SPI           = scripting.addModule("/ti/driverlib/SPI", {}, false);
const SPI_IMU       = SPI.addInstance();
const SYSCTL        = scripting.addModule("/ti/driverlib/SYSCTL");
const SYSTICK       = scripting.addModule("/ti/driverlib/SYSTICK");
const UART          = scripting.addModule("/ti/driverlib/UART", {}, false);
const UART_MOTOR    = UART.addInstance();
const ProjectConfig = scripting.addModule("/ti/project_config/ProjectConfig");

const Board = scripting.addModule("/ti/driverlib/Board", {}, false);

SYSCTL.forceDefaultClkConfig = true;
SYSCTL.clockTreeEn           = true;

ProjectConfig.deviceSpin = "MSPM0G3507";

SYSTICK.periodEnable      = true;
SYSTICK.interruptEnable   = true;
SYSTICK.systickEnable     = true;
SYSTICK.period            = 32000;
SYSTICK.interruptPriority = "2";

UART_MOTOR.$name                            = "UART_MOTOR";
UART_MOTOR.targetBaudRate                   = 115200;
UART_MOTOR.enabledInterrupts                = ["RX"];
UART_MOTOR.interruptPriority                = "0";
UART_MOTOR.peripheral.$assign               = "UART1";
UART_MOTOR.peripheral.txPin.$assign         = "PA8";
UART_MOTOR.peripheral.rxPin.$assign         = "PA9";
UART_MOTOR.txPinConfig.direction            = scripting.forceWrite("OUTPUT");
UART_MOTOR.txPinConfig.hideOutputInversion  = scripting.forceWrite(false);
UART_MOTOR.txPinConfig.onlyInternalResistor = scripting.forceWrite(false);
UART_MOTOR.txPinConfig.passedPeripheralType = scripting.forceWrite("Digital");
UART_MOTOR.rxPinConfig.hideOutputInversion  = scripting.forceWrite(false);
UART_MOTOR.rxPinConfig.onlyInternalResistor = scripting.forceWrite(false);
UART_MOTOR.rxPinConfig.passedPeripheralType = scripting.forceWrite("Digital");

SPI_IMU.$name                              = "SPI_IMU";
SPI_IMU.targetBitRate                      = 4000000;
SPI_IMU.frameFormat                        = "MOTO3";
SPI_IMU.polarity                           = "0";
SPI_IMU.phase                              = "0";
SPI_IMU.dataSize                           = 8;
SPI_IMU.chipSelect                         = [];
SPI_IMU.peripheral.$assign                 = "SPI1";
SPI_IMU.peripheral.misoPin.$assign         = "PB7";
SPI_IMU.peripheral.mosiPin.$assign         = "PB8";
SPI_IMU.peripheral.sclkPin.$assign         = "PB9";
SPI_IMU.sclkPinConfig.direction            = scripting.forceWrite("OUTPUT");
SPI_IMU.sclkPinConfig.onlyInternalResistor = scripting.forceWrite(false);
SPI_IMU.sclkPinConfig.passedPeripheralType = scripting.forceWrite("Digital");
SPI_IMU.mosiPinConfig.direction            = scripting.forceWrite("OUTPUT");
SPI_IMU.mosiPinConfig.hideOutputInversion  = scripting.forceWrite(false);
SPI_IMU.mosiPinConfig.onlyInternalResistor = scripting.forceWrite(false);
SPI_IMU.mosiPinConfig.passedPeripheralType = scripting.forceWrite("Digital");
SPI_IMU.misoPinConfig.onlyInternalResistor = scripting.forceWrite(false);
SPI_IMU.misoPinConfig.passedPeripheralType = scripting.forceWrite("Digital");

ADC_GRAY.$name                      = "ADC_GRAY";
ADC_GRAY.sampleTime0                = "2 us";
ADC_GRAY.sampClkDiv                 = "DL_ADC12_CLOCK_DIVIDE_8";
ADC_GRAY.enabledInterrupts          = ["DL_ADC12_INTERRUPT_MEM0_RESULT_LOADED"];
ADC_GRAY.adcMem0_name               = "GRAY_OUT";
ADC_GRAY.repeatMode                 = false;
ADC_GRAY.peripheral.$assign         = "ADC0";
ADC_GRAY.peripheral.adcPin0.$assign = "PA27";

GPIO_GRAY.$name                         = "GPIO_GRAY";
GPIO_GRAY.associatedPins.create(3);
GPIO_GRAY.associatedPins[0].$name       = "AD0";
GPIO_GRAY.associatedPins[0].pin.$assign = "PA24";
GPIO_GRAY.associatedPins[1].$name       = "AD1";
GPIO_GRAY.associatedPins[1].pin.$assign = "PA25";
GPIO_GRAY.associatedPins[2].$name       = "AD2";
GPIO_GRAY.associatedPins[2].pin.$assign = "PA26";

GPIO_IMU.$name                           = "GPIO_IMU";
GPIO_IMU.associatedPins[0].$name         = "CS";
GPIO_IMU.associatedPins[0].initialValue  = "SET";
GPIO_IMU.associatedPins[0].pin.$assign   = "PB0";

GPIO_KEYS.$name                              = "GPIO_KEYS";
GPIO_KEYS.associatedPins[0].$name            = "START";
GPIO_KEYS.associatedPins[0].direction        = "INPUT";
GPIO_KEYS.associatedPins[0].internalResistor = "PULL_UP";
GPIO_KEYS.associatedPins[0].pin.$assign      = "PB10";

GPIO_BUZZER.$name                          = "GPIO_BUZZER";
GPIO_BUZZER.associatedPins[0].$name        = "BUZZER";
GPIO_BUZZER.associatedPins[0].initialValue = "CLEARED";
GPIO_BUZZER.associatedPins[0].pin.$assign  = "PB5";

Board.peripheral.$suggestSolution          = "DEBUGSS";
Board.peripheral.swclkPin.$suggestSolution = "PA20";
Board.peripheral.swdioPin.$suggestSolution = "PA19";
