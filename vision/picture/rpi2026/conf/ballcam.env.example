# ballcam 配置。install.sh 会拷成 conf/ballcam.env 后再改这份副本。
# 改完执行：sudo systemctl restart ballcam-api

# 相机 IP。留空 = 从 NetworkManager 的 DHCP lease 表自动发现（推荐，永远不用手填）
CAM_HOST=

# ESP32-CAM CameraWebServer 固件的默认端口：81 出 MJPEG 流，80 是网页和 /control
CAM_STREAM_PORT=81
CAM_CTRL_PORT=80

# 数据区（录像）。和代码区分开，install.sh 会按实际家目录改写这行
DATA_DIR=/home/pi/data/ti_vision/2026

# h264 编码器：libx264（软编，稳）/ h264_v4l2m2m（Pi4 硬编，省 CPU 但偶发不兼容）
H264_ENC=libx264

# 目标帧率。只用于 GOP 长度和回放逐帧步进的步长，不改变相机实际帧率
TARGET_FPS=15

UI_PORT=8000

# 热点连接名（scripts/net-ap.sh 建的那个）
AP_CON=ap-ballcam

# NetworkManager 共享模式的 DHCP lease 文件，用于自动发现相机
LEASE_FILE=/var/lib/NetworkManager/dnsmasq-wlan0.leases
